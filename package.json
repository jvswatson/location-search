{
  "name": "location-search",
  "private": true,
  "description": "Searchable airports table and map backed by NestJS + PostGIS",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test:unit": "pnpm build:shared && pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm -r test:e2e",
    "build:shared": "pnpm --filter @location-search/shared build",
    "build": "pnpm build:shared && pnpm -r --filter=!@location-search/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @location-search/api --filter @location-search/web dev",
    "docker:db": "docker compose up -d --wait db",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:e2e:up": "docker compose -f docker-compose.e2e.yml up -d --build --wait",
    "docker:e2e:down": "docker compose -f docker-compose.e2e.yml down -v"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
